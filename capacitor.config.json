{
  "appId": "com.reotesis.sakin",
  "appName": "REO Sakin",
  "webDir": "www",
  "backgroundColor": "#0b3b60",
  "server": {
    "allowNavigation": ["reo-portal.com", "www.reo-portal.com", "script.google.com", "*.googleusercontent.com", "*.google.com", "*.gstatic.com", "fonts.googleapis.com", "cdn.jsdelivr.net"]
  },
  "ios": { "contentInset": "never", "backgroundColor": "#0b3b60", "limitsNavigationsToAppBoundDomains": false },
  "android": { "backgroundColor": "#0b3b60" },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 1500, "launchAutoHide": false, "backgroundColor": "#ffffff", "showSpinner": false },
    "FirebaseMessaging": { "presentationOptions": ["badge", "sound", "alert"] }
  }
}
